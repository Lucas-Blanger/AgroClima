# Django Settings
SECRET_KEY=django-insecure-dev-key-only-for-testing-never-use-in-production-12345678
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api,*.localhost


# Database 
DB_NAME=agroclima_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# API Keys (use your own keys from openweathermap.org and newsapi.org)
OPENWEATHER_API_KEY=your_openweather_api_key_here
NEWS_API_KEY=your_newsapi_key_here

# Localização (exemplo: São Paulo, Brasil)
CITY_NAME=São Paulo
CITY_LAT=-23.5505
CITY_LON=-46.6333
STATE_CODE=SP

# CORS (Frontend URL)
FRONTEND_URL=http://localhost

# Logging (optional)
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=agroclima.log
LOG_TO_CONSOLE=True
